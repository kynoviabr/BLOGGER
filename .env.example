# ==============================================================================
# CONTENT FACTORY - ENVIRONMENT CONFIGURATION (FASE 01 - FOUNDATION)
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Security & Cron Jobs
CRON_SECRET=your_secure_cron_job_secret_token_here

# AI Pipeline Providers (Reserved for future phases)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Image Generation Providers (Reserved for future phases)
IMAGE_PROVIDER=gemini # e.g., gemini, imagen-3, recraft
IMAGE_API_KEY=your_image_api_key_here

# Publishing Providers (Reserved for future phases)
PUBLISHER_TYPE=mock # e.g., mock, wordpress, custom_webhook, ghost
PUBLISHER_API_KEY=your_publisher_api_key_here
PUBLISHER_ENDPOINT=https://yourblog.com/api/posts
