# ==============================================================================
# CONTENT FACTORY - ENVIRONMENT CONFIGURATION (FASE 01 - FOUNDATION)
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Security & Cron Jobs
CRON_SECRET=your_secure_cron_job_secret_token_here

# AI Pipeline Providers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Image Generation Providers
IMAGE_PROVIDER=openai # e.g., openai, pollinations, nanobanana, mock
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1536x1024
POLLINATIONS_MODEL=flux # fallback or alternative: flux
IMAGE_API_KEY=your_image_api_key_here # optional / legacy provider

# Publishing Providers (Reserved for future phases)
PUBLISHER_TYPE=mock # e.g., mock, wordpress, custom_webhook, ghost
PUBLISHER_API_KEY=your_publisher_api_key_here
PUBLISHER_ENDPOINT=https://yourblog.com/api/posts
